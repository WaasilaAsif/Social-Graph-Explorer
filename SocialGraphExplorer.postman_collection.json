              "path": ["api", "users", "search"],
              "query": [
                {
                  "key": "prefix",
                  "value": "ali"
                }
              ]
            }
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [],
