        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/users/{{user_id}}/posts/0",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "{{user_id}}", "posts", "0"]
            }
          }
        }
      ]
